# Required for Gemini text generation
#GEMINI_API_KEY=AQ.Ab8RN6KynRPW8cizYEuJlmwOpiBxl3wrz8HJOketr9STxGZ2nA
GEMINI_API_KEY=your_gemini_api_key_here
# Current Gemini model defaults
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview

# placeholder = runs without a local image model
# diffusers = use local Stable Diffusion through Hugging Face Diffusers
IMAGE_BACKEND=placeholder

# Used only when IMAGE_BACKEND=diffusers
SD_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
HF_TOKEN=
